# --- Supabase (Postgres + Auth + Storage + pgvector) ---
# Public — safe to expose to the browser (used by apps/web)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never expose to the browser. Used by services/reducer
# and by server-side code in apps/web for privileged writes.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Redis (arq queue backing the reducer for >10k rows) ---
REDIS_URL=redis://localhost:6379/0

# --- Reducer service (used by apps/web server routes to dispatch jobs) ---
REDUCER_URL=http://127.0.0.1:8000

# --- Optional: OpenAI embeddings (opt-in toggle; default is local MiniLM) ---
# Leave blank to keep the free local embedder as the default.
OPENAI_API_KEY=
