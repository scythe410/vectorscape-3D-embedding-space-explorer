# --- Supabase (Postgres + Auth + Storage + pgvector) ---
# Public — safe to expose to the browser (used by apps/web)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never expose to the browser. Used by services/reducer
# and by server-side code in apps/web for privileged writes.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Redis (arq queue backing the reducer for >10k rows) ---
REDIS_URL=redis://localhost:6379/0

# --- Reducer service (used by apps/web server routes to dispatch jobs) ---
REDUCER_URL=http://127.0.0.1:8000
# Shared secret for service-to-service auth. Set the SAME value on both the
# Next.js server (REDUCER_SHARED_SECRET) and the reducer service. Without it,
# the reducer rejects every call with 503. NEVER expose this to the browser —
# it lives in the Next server-only env, not NEXT_PUBLIC_*. For local dev use
# something like "dev-local"; in production, use a cryptographically random
# 32+ character value rotated regularly.
REDUCER_SHARED_SECRET=dev-local

# --- Optional: LLM key for /bridge cluster explanations ---
# OPENAI_API_KEY also enables embed_model=openai. GEMINI_API_KEY is /bridge-only
# and routes through Gemini's OpenAI-compatible endpoint (free tier on AI Studio).
# If both are set, OpenAI wins. Leave both blank to ship medoids + boundary
# points without the prose summary.
OPENAI_API_KEY=
GEMINI_API_KEY=
