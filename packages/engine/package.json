{
  "name": "engine",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/engine.cjs",
  "module": "./dist/engine.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/engine.js",
      "require": "./dist/engine.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && tsc --emitDeclarationOnly -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "three": ">=0.160"
  },
  "devDependencies": {
    "@types/react": "19.0.0",
    "@types/three": "0.170.0",
    "react": "19.0.0",
    "three": "0.170.0",
    "typescript": "5.6.3",
    "vite": "5.4.10"
  }
}
